<Window x:Class="Spool.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting Spool" Width="430" Height="250" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
  <Border Background="#111617" BorderBrush="#30393A" BorderThickness="1" CornerRadius="9" Padding="28">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="34" Height="34" Margin="0,0,13,0"><Ellipse Stroke="#C27B48" StrokeThickness="2.3" Margin="3" /><Ellipse Fill="#C27B48" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" /><Rectangle Fill="#111617" Width="12" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" /><Line X1="18" Y1="17" X2="33" Y2="17" Stroke="#C27B48" StrokeThickness="2.3" /></Grid>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="SPOOL" FontSize="14" FontWeight="Bold" Foreground="#F0F1ED" /><TextBlock Text="INSTANT REPLAY" FontSize="8" Foreground="#76817D" Margin="0,3,0,0" /></StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <TextBlock Text="Ready when the moment happens." FontSize="17" FontWeight="SemiBold" Foreground="#F0F1ED" />
        <TextBlock x:Name="StatusText" Text="Starting local capture service…" FontSize="11" Foreground="#A1AAA6" Margin="0,8,0,0" />
      </StackPanel>
      <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Background="#293233" Foreground="#C27B48" BorderThickness="0" />
    </Grid>
  </Border>
</Window>
