<Window x:Class="Spool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spool" Width="1160" Height="760" MinWidth="980" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Canvas}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#293132" BorderThickness="1" Background="{StaticResource Canvas}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#111617">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="False">
          <Grid Width="23" Height="23" Margin="0,0,9,0">
            <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="2" />
            <Ellipse Fill="{StaticResource Accent}" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle Fill="#111617" Width="8" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Line X1="13" Y1="11.5" X2="22" Y2="11.5" Stroke="{StaticResource Accent}" StrokeThickness="2" />
          </Grid>
          <TextBlock Text="SPOOL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
          <TextBlock Text="INSTANT REPLAY" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="9,1,0,0" />
        </StackPanel>
        <TextBlock x:Name="TitleStatus" Grid.Column="1" Text="Starting local capture service" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="20,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="False" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Width="46" Height="42" Content="—" FontSize="16" Foreground="{StaticResource TextSecondary}" Background="Transparent" BorderThickness="0" Click="Minimize_Click" Cursor="Hand" />
          <Button Width="46" Height="42" Content="□" FontSize="14" Foreground="{StaticResource TextSecondary}" Background="Transparent" BorderThickness="0" Click="Maximize_Click" Cursor="Hand" />
          <Button Width="46" Height="42" Content="×" FontSize="18" Foreground="{StaticResource TextSecondary}" Background="Transparent" BorderThickness="0" Click="Close_Click" Cursor="Hand" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="#222A2B" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="14,23,14,0">
              <TextBlock Text="CAPTURE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="12,0,0,12" />
              <Button x:Name="ReplayNav" Style="{StaticResource NavButton}" Click="ReplayNav_Click" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal"><Border x:Name="ReplayMark" Width="3" Height="18" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,11,0" /><TextBlock Text="Instant replay" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="ClipsNav" Style="{StaticResource NavButton}" Click="ClipsNav_Click" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal"><Border x:Name="ClipsMark" Width="3" Height="18" Background="Transparent" CornerRadius="2" Margin="0,0,11,0" /><TextBlock Text="Clip library" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click">
                <StackPanel Orientation="Horizontal"><Border x:Name="SettingsMark" Width="3" Height="18" Background="Transparent" CornerRadius="2" Margin="0,0,11,0" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#222A2B" BorderThickness="0,1,0,0" Padding="19,15,18,17">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock x:Name="EngineStateLabel" Text="CONNECTING" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="Capture runs locally" FontSize="10" Foreground="{StaticResource TextMuted}" />
                <TextBlock Text="No account · No cloud" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <Grid x:Name="ReplayPage" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="34,26,34,34">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <StackPanel><TextBlock Text="Instant replay" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Your last moments stay ready while you play." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" /></StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="ReplayDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" Margin="0,0,8,0" /><TextBlock x:Name="ReplayStatusText" Text="PAUSED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" /></StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="25,23,25,21">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid Grid.Row="0"><TextBlock Text="REPLAY BUFFER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="BufferStateText" Text="WAITING" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" /></Grid>
                      <Grid Grid.Row="1" Margin="0,23,0,0">
                        <StackPanel><TextBlock x:Name="ReplayStateText" Text="Paused" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="BufferDetailText" Text="Start replay to begin buffering." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" /></StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ReplayLengthText" Text="30" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="SECONDS" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,-1,2,0" /></StackPanel>
                      </Grid>
                      <ProgressBar x:Name="BufferProgress" Grid.Row="2" Height="3" Margin="0,19,0,20" Minimum="0" Maximum="100" Value="0" Background="#273031" Foreground="{StaticResource Accent}" BorderThickness="0" />
                      <Border Grid.Row="3" Background="{StaticResource Line}" />
                      <Grid Grid.Row="4" Margin="0,19,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="SaveHotkeyBadge" Text="F8" FontFamily="Cascadia Mono" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Background="#252D2E" Padding="8,5" /><TextBlock Text="SAVE THE LAST" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,7,0" /><TextBlock x:Name="SaveLengthLabel" Text="30 SEC" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ToggleReplayButton" Style="{StaticResource QuietButton}" Content="Start replay" Click="ToggleReplay_Click" Margin="0,0,8,0" /><Button x:Name="SaveClipButton" Style="{StaticResource AccentButton}" Content="Save clip" Click="SaveClip_Click" IsEnabled="False" /></StackPanel>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="2" Background="#151A1B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="22,21,22,18">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="CURRENT SESSION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                      <StackPanel Grid.Row="1" Margin="0,18,0,16"><TextBlock x:Name="GameNameText" Text="No game detected" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="CaptureTargetText" Text="Display capture" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel>
                      <Border Grid.Row="2" Background="{StaticResource Line}" />
                      <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="RESOLUTION" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="ResolutionText" Text="1920 × 1080" FontSize="10" HorizontalAlignment="Right" /></Grid>
                      <Grid Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="FRAME RATE" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="FpsText" Text="60 FPS" FontSize="10" HorizontalAlignment="Right" /></Grid>
                      <Grid Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="HARDWARE ENCODER" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="EncoderText" Text="AMD AMF HEVC" FontSize="10" HorizontalAlignment="Right" /></Grid>
                    </Grid>
                  </Border>
                </Grid>

                <Grid Grid.Row="4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16,13"><StackPanel><TextBlock Text="CPU" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="CpuMetricText" Text="n/a" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="Spool + capture" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" /></StackPanel></Border>
                  <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16,13"><StackPanel><TextBlock Text="MEMORY" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="MemoryMetricText" Text="n/a" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="Working sets" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" /></StackPanel></Border>
                  <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16,13"><StackPanel><TextBlock Text="GPU" FontSize="9" Foreground="{StaticResource TextMuted}" /><TextBlock x:Name="GpuMetricText" Text="n/a" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="Capture engine" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" /></StackPanel></Border>
                </Grid>

                <Grid Grid.Row="6">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid Grid.Row="0"><TextBlock Text="Recent clips" FontSize="14" FontWeight="SemiBold" /><Button Style="{StaticResource QuietButton}" Content="View library" Click="ClipsNav_Click" HorizontalAlignment="Right" Padding="10,5" /></Grid>
                  <ItemsControl x:Name="RecentClipsList" Grid.Row="2">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource Panel}" BorderBrush="#242D2E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,7">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="94" Height="53" Background="#222A2B" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="Open" Tag="{Binding File}" Click="OpenClip_Click" VerticalAlignment="Center" Padding="11,5" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Grid>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="ClipsPage" Visibility="Collapsed">
            <Grid Margin="34,26,34,28">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Grid.Row="0"><StackPanel><TextBlock Text="Clip library" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="ClipCountText" Text="Saved locally on this PC" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" /></StackPanel><Button Style="{StaticResource QuietButton}" Content="Open folder" Click="OpenClipFolder_Click" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
              <Grid Grid.Row="1" Margin="0,20,0,14"><TextBox x:Name="ClipSearchBox" Width="260" Height="34" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="10,0" Background="{StaticResource Panel}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Line}" TextChanged="ClipSearch_TextChanged" ToolTip="Search clips" /><TextBlock x:Name="LibraryStatusText" Text="" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
              <Border Grid.Row="2" Background="#121718" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                  <ItemsControl x:Name="ClipsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource Panel}" BorderBrush="#252E2F" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,8">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="154" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="140" Height="79" Background="#222A2B" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,12,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" /><TextBlock Text="{Binding FileSize}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Style="{StaticResource AccentButton}" Content="Play" Tag="{Binding File}" Click="PlayClip_Click" Margin="0,0,6,0" Padding="12,7" />
                              <Button Style="{StaticResource QuietButton}" Content="Show" Tag="{Binding File}" Click="RevealClip_Click" Margin="0,0,6,0" Padding="10,7" />
                              <Button Style="{StaticResource QuietButton}" Content="Rename" Tag="{Binding File}" Click="RenameClip_Click" Margin="0,0,6,0" Padding="10,7" />
                              <Button Style="{StaticResource QuietButton}" Content="Delete" Tag="{Binding File}" Click="DeleteClip_Click" Padding="10,7" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid Margin="34,26,34,28">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <StackPanel Grid.Row="0"><TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Tune capture, hotkeys and local storage." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" /></StackPanel>
              <TabControl Grid.Row="1" x:Name="SettingsTabs" Margin="0,21,0,0" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource TextSecondary}" /><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="13,9" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                </TabControl.Resources>
                <TabItem Header="Recording">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,17,0,0"><Grid MaxWidth="750" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Style="{StaticResource FieldLabel}" Text="Replay length" /><ComboBox x:Name="ReplayLengthCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Resolution" /><ComboBox x:Name="ResolutionCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate" /><ComboBox x:Name="FpsCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Bitrate" /><ComboBox x:Name="BitrateCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0"><TextBlock Style="{StaticResource FieldLabel}" Text="Hardware encoder" /><ComboBox x:Name="EncoderCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Quality preset" /><ComboBox x:Name="QualityCombo" Style="{StaticResource SettingCombo}" /></StackPanel>
                  </Grid></ScrollViewer>
                </TabItem>
                <TabItem Header="Audio">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,17,0,0"><StackPanel MaxWidth="750" HorizontalAlignment="Left">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="15,13" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="Microphone" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="MicSettingHelp" Text="The microphone is captured as AAC audio." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" /></StackPanel><Button x:Name="MicToggleSetting" Style="{StaticResource QuietButton}" Content="On" Click="Mic_Click" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Style="{StaticResource FieldLabel}" Text="Input device" /><ComboBox x:Name="MicrophoneCombo" Style="{StaticResource SettingCombo}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Microphone volume" /><ComboBox x:Name="MicrophoneVolumeCombo" Style="{StaticResource SettingCombo}" /></StackPanel></Grid>
                    <Border Background="#181C1D" BorderBrush="#313839" BorderThickness="1" CornerRadius="5" Padding="13,11" Margin="0,16,0,0"><StackPanel><TextBlock Text="Game and system audio" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="This FFmpeg build has no WASAPI loopback source. Those tracks stay disabled until a supported capture path is available." FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                  </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Hotkeys">
                  <StackPanel MaxWidth="570" HorizontalAlignment="Left" Margin="0,17,0,0">
                    <TextBlock Text="Press a key or key combination to assign it. The app registers hotkeys with Windows." FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBlock Text="Save clip" FontSize="12" VerticalAlignment="Center" /><Button x:Name="SaveHotkeyButton" Grid.Column="1" Style="{StaticResource QuietButton}" Content="F8 · Change" Tag="save" Click="CaptureHotkey_Click" /></Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBlock Text="Toggle instant replay" FontSize="12" VerticalAlignment="Center" /><Button x:Name="ToggleHotkeyButton" Grid.Column="1" Style="{StaticResource QuietButton}" Content="F9 · Change" Tag="toggle" Click="CaptureHotkey_Click" /></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBlock Text="Toggle microphone" FontSize="12" VerticalAlignment="Center" /><Button x:Name="MicHotkeyButton" Grid.Column="1" Style="{StaticResource QuietButton}" Content="F10 · Change" Tag="microphone" Click="CaptureHotkey_Click" /></Grid>
                  </StackPanel>
                </TabItem>
                <TabItem Header="Storage">
                  <StackPanel MaxWidth="750" HorizontalAlignment="Left" Margin="0,17,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Clip folder" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ClipFolderText" Height="36" Padding="9,0" VerticalContentAlignment="Center" Background="{StaticResource Panel}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Line}" /><Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="Browse" Click="BrowseClipFolder_Click" Padding="11,6" /></Grid>
                    <StackPanel Margin="0,17,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Maximum library size" /><ComboBox x:Name="MaxStorageCombo" Style="{StaticResource SettingCombo}" Width="180" HorizontalAlignment="Left" /></StackPanel>
                    <CheckBox x:Name="AutoStartCheck" Content="Start replay when Spool opens" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,22,0,0" />
                    <CheckBox x:Name="LaunchAtLoginCheck" Content="Open Spool when I sign in to Windows" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,13,0,0" />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Discord">
                  <StackPanel MaxWidth="650" HorizontalAlignment="Left" Margin="0,17,0,0">
                    <TextBlock Text="Rich Presence" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="When enabled and Discord is open, Spool can publish its current capture state. This does not detect games; local process detection supplies the game name." FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,15" />
                    <CheckBox x:Name="DiscordEnabledCheck" Content="Publish Spool activity to Discord" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Discord application ID" Margin="0,17,0,7" />
                    <TextBox x:Name="DiscordClientIdText" Height="36" Padding="9,0" VerticalContentAlignment="Center" Background="{StaticResource Panel}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Line}" />
                    <TextBlock x:Name="DiscordStatusText" Text="Presence is off." FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" />
                    <TextBlock Text="A Discord application ID is required to enable Rich Presence. The feature stays off until one is supplied." FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Performance">
                  <StackPanel MaxWidth="650" HorizontalAlignment="Left" Margin="0,17,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Capture method" />
                    <ComboBox x:Name="CaptureMethodCombo" Style="{StaticResource SettingCombo}" Width="240" HorizontalAlignment="Left" />
                    <CheckBox x:Name="BackgroundPriorityCheck" Content="Run capture engine below normal priority" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,20,0,0" />
                    <TextBlock Text="Auto selects the detected game's window and falls back to the display. Window capture uses Windows Graphics Capture without injecting code into games." FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                  </StackPanel>
                </TabItem>
              </TabControl>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1"><TextBlock x:Name="SettingsSaveStatus" Text="" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,13,0" /><Button Style="{StaticResource AccentButton}" Content="Save settings" Click="SaveSettings_Click" Padding="16,8" /></StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
      <Border x:Name="ToastSurface" Grid.Row="1" Background="#252D2E" BorderBrush="#44504F" BorderThickness="1" CornerRadius="6" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="ToastText" FontSize="11" /></Border>
    </Grid>
  </Border>
</Window>
