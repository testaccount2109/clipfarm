{
  "name": "clipfarm",
  "productName": "clipfarm",
  "private": true,
  "version": "1.0.2",
  "description": "Windows-Gaming-Clips mit lokaler Capture-Engine",
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-updater.ps1",
    "build:win": "electron-builder --win nsis --publish never",
    "pack:win": "electron-builder --win dir",
    "pack:update": "electron-builder --win dir --config.directories.output=release-update"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.clipfarm.desktop",
    "productName": "clipfarm",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "backend-config.js",
      "community-service.js",
      "preload.js",
      "overlay-preload.js",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "splash.html",
      "index.html",
      "assets/clipfarm-icons.svg",
      "desktop/branding/clipfarm-mark.svg",
      "styles.css",
      "app.js",
      "server.js",
      "engine-config.json",
      "README.md",
      "erfolgreich.mp3",
      "failed.mp3"
    ],
    "extraResources": [
      {
        "from": "desktop/branding/clipfarm.ico",
        "to": "clipfarm.ico"
      },
      {
        "from": "tools/clipfarm-audio.exe",
        "to": "clipfarm-audio.exe"
      }
    ],
    "win": {
      "icon": "desktop/branding/clipfarm.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Clipfarm",
      "menuCategory": "Clipfarm",
      "installerIcon": "desktop/branding/clipfarm.ico",
      "uninstallerIcon": "desktop/branding/clipfarm.ico",
      "installerSidebar": "desktop/branding/clipfarm-installer-sidebar.bmp",
      "installerLanguages": ["de_DE"],
      "language": 1031,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
