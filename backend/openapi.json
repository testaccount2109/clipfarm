{
  "openapi": "3.1.0",
  "info": {
    "title": "Clipfarm Community API",
    "version": "1.1.0",
    "description": "HTTPS API for Clipfarm accounts, profiles, privacy settings, the chronological community feed, and MP4 uploads."
  },
  "servers": [{ "url": "https://benni-projects.de/api/v1" }],
  "tags": [
    { "name": "Health" },
    { "name": "Account" },
    { "name": "Clips" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check the Clipfarm API service",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is ready.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["ok", "service", "version", "capabilities"], "properties": { "ok": { "type": "boolean", "const": true }, "service": { "type": "string", "const": "clipfarm-community-api" }, "version": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "string", "enum": ["auth", "clips", "uploads", "playback", "profiles", "profileWrite", "privateClips", "passwordChange", "avatars"] } } } } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["Health"],
        "summary": "Read this API contract",
        "security": [],
        "responses": { "200": { "description": "OpenAPI 3.1 document." } }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Account"],
        "summary": "Create an account",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/Credentials" },
        "responses": {
          "201": { "$ref": "#/components/responses/Session" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "description": "Username is already taken." },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Account"],
        "summary": "Start a session",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/Credentials" },
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Account"],
        "summary": "Read the active account",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated account.", "content": { "application/json": { "schema": { "type": "object", "properties": { "authenticated": { "type": "boolean" }, "user": { "$ref": "#/components/schemas/User" } } } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Account"],
        "summary": "Rotate a refresh token and issue a new access token",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Account"],
        "summary": "Revoke this session",
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Session revoked." }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profile": {
      "get": {
        "tags": ["Account"],
        "summary": "Read the authenticated user's profile and privacy settings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Profile" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Account"],
        "summary": "Update the authenticated user's profile and privacy settings",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileUpdate" },
        "responses": {
          "200": { "$ref": "#/components/responses/Profile" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/profile/password": {
      "post": {
        "tags": ["Account"],
        "summary": "Change the authenticated user's password",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/PasswordChange" },
        "responses": {
          "200": { "description": "Password changed.", "content": { "application/json": { "schema": { "type": "object", "required": ["changed"], "properties": { "changed": { "type": "boolean", "const": true } } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/users/{id}/avatar": {
      "get": {
        "tags": ["Account"],
        "summary": "Read a public profile avatar",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "PNG, JPEG, or WebP avatar image.", "content": { "image/png": {}, "image/jpeg": {}, "image/webp": {} } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "head": {
        "tags": ["Account"],
        "summary": "Read avatar response headers",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Avatar response headers." }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/clips": {
      "get": {
        "tags": ["Clips"],
        "summary": "Read the community feed in newest-first order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["uploadedAt"] } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["desc"] } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["mine"] }, "description": "Return only clips uploaded by the authenticated user." },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "A page of real uploaded clips.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClipPage" } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Clips"],
        "summary": "Upload an MP4 clip",
        "description": "Streams one MP4 to a temporary file, verifies its container signature and size, then atomically stores it with the clip metadata. Retrying the same Idempotency-Key returns the original stored clip.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128 } },
          { "name": "X-Clip-Title-Base64", "in": "header", "required": true, "schema": { "type": "string" }, "description": "UTF-8 title encoded as base64url." },
          { "name": "X-Clip-Game-Base64", "in": "header", "required": true, "schema": { "type": "string" }, "description": "UTF-8 game name encoded as base64url." },
          { "name": "X-Clip-Duration-Seconds", "in": "header", "required": true, "schema": { "type": "integer", "minimum": 1, "maximum": 86400 } }
        ],
        "requestBody": { "required": true, "content": { "video/mp4": { "schema": { "type": "string", "format": "binary" } } } },
        "responses": {
          "201": { "description": "Clip committed to storage.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResult" } } } },
          "200": { "description": "The idempotency key already has a committed clip.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResult" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/clips/{id}/media": {
      "get": {
        "tags": ["Clips"],
        "summary": "Stream a stored community clip",
        "description": "Short-lived signed media URL with byte-range support. Private clips are playable only by their owner.",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "MP4 stream.", "content": { "video/mp4": { "schema": { "type": "string", "format": "binary" } } }, "headers": { "Accept-Ranges": { "schema": { "type": "string", "const": "bytes" } } } },
          "206": { "description": "Requested byte range.", "content": { "video/mp4": { "schema": { "type": "string", "format": "binary" } } }, "headers": { "Content-Range": { "schema": { "type": "string" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "head": {
        "tags": ["Clips"],
        "summary": "Read media headers",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "MP4 stream headers." }, "404": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "username", "displayName", "avatarUrl"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "username": { "type": "string" }, "displayName": { "type": "string" }, "avatarUrl": { "type": ["string", "null"], "format": "uri" } }
      },
      "Profile": {
        "type": "object",
        "required": ["id", "username", "displayName", "avatarUrl", "bio", "shareClips", "localOnly"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "username": { "type": "string" }, "displayName": { "type": "string" }, "avatarUrl": { "type": ["string", "null"], "format": "uri" }, "bio": { "type": "string", "maxLength": 280 }, "shareClips": { "type": "boolean" }, "localOnly": { "type": "boolean" } }
      },
      "ProfileResult": {
        "type": "object",
        "required": ["profile"],
        "properties": { "profile": { "$ref": "#/components/schemas/Profile" } }
      },
      "Clip": {
        "type": "object",
        "required": ["id", "title", "creator", "game", "uploadedAt", "durationSeconds", "sizeBytes", "thumbnailUrl", "mediaUrl"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "creator": { "type": "string" },
          "game": { "type": "string" },
          "uploadedAt": { "type": "string", "format": "date-time" },
          "durationSeconds": { "type": "integer" },
          "sizeBytes": { "type": "integer" },
          "thumbnailUrl": { "type": ["string", "null"], "format": "uri" },
          "mediaUrl": { "type": "string", "format": "uri" }
        }
      },
      "ClipPage": {
        "type": "object",
        "required": ["clips", "nextCursor", "sort", "viewer"],
        "properties": {
          "clips": { "type": "array", "items": { "$ref": "#/components/schemas/Clip" } },
          "nextCursor": { "type": ["string", "null"] },
          "sort": { "type": "string", "const": "uploadedAt:desc" },
          "viewer": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "username": { "type": "string" } } }
        }
      },
      "Session": {
        "type": "object",
        "required": ["accessToken", "accessExpiresAt", "refreshToken", "user"],
        "properties": {
          "accessToken": { "type": "string" },
          "accessExpiresAt": { "type": "string", "format": "date-time" },
          "refreshToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "UploadResult": {
        "type": "object",
        "required": ["clip", "stored", "duplicate"],
        "properties": {
          "clip": { "$ref": "#/components/schemas/Clip" },
          "stored": { "type": "boolean", "const": true },
          "duplicate": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    },
    "requestBodies": {
      "ProfileUpdate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["displayName"],
              "properties": {
                "displayName": { "type": "string", "minLength": 1, "maxLength": 32 },
                "bio": { "type": "string", "maxLength": 280 },
                "shareClips": { "type": "boolean" },
                "localOnly": { "type": "boolean" },
                "avatarData": { "type": ["string", "null"], "description": "PNG, JPEG, or WebP data URI; null removes the current avatar." }
              }
            }
          }
        }
      },
      "PasswordChange": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["currentPassword", "newPassword"],
              "properties": {
                "currentPassword": { "type": "string", "minLength": 1, "maxLength": 256 },
                "newPassword": { "type": "string", "minLength": 10, "maxLength": 256 }
              }
            }
          }
        }
      },
      "Credentials": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Za-z0-9_.-]+$" },
                "password": { "type": "string", "minLength": 10, "maxLength": 128, "writeOnly": true }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Profile": { "description": "The user's profile and privacy settings.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileResult" } } } },
      "Session": { "description": "Authenticated session.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
      "Error": { "description": "Request failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
